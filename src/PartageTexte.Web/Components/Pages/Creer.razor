@page "/"
@rendermode InteractiveServer
@inject IClientPartage ClientPartage
@inject NavigationManager Navigation

<PageTitle>Nouveau partage — CFCAL</PageTitle>

<div class="container-narrow">
    <div class="stack stack-lg">

        <!-- Titre -->
        <div>
            <h1 class="page-title">Partager de façon sécurisée</h1>
            <p class="page-subtitle">Le contenu est chiffré en AES-256 et n'est jamais stocké en clair.</p>
        </div>

        <!-- Aide contextuelle -->
        <div class="help-panel">
            <button class="help-toggle" @onclick="() => _aideOuverte = !_aideOuverte" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <span>Comment fonctionne le partage sécurisé ?</span>
                <svg class="help-chevron @(_aideOuverte ? "open" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>
            @if (_aideOuverte)
            {
                <div class="help-body">
                    <div class="help-grid">
                        <div class="help-item">
                            <div class="help-icon">🔒</div>
                            <div>
                                <strong>Chiffrement AES-256</strong>
                                <p>Votre contenu est chiffré avant d'être stocké. Même l'administrateur ne peut pas le lire.</p>
                            </div>
                        </div>
                        <div class="help-item">
                            <div class="help-icon">⏱️</div>
                            <div>
                                <strong>Expiration automatique</strong>
                                <p>Le partage est automatiquement supprimé à la date d'expiration choisie.</p>
                            </div>
                        </div>
                        <div class="help-item">
                            <div class="help-icon">🔑</div>
                            <div>
                                <strong>Protection par mot de passe</strong>
                                <p>Ajoutez un mot de passe pour que seul le destinataire autorisé puisse lire le contenu.</p>
                            </div>
                        </div>
                        <div class="help-item">
                            <div class="help-icon">👁️</div>
                            <div>
                                <strong>Limite de lectures</strong>
                                <p>Définissez un nombre maximum de lectures pour garantir que le contenu n'est lu qu'une seule fois.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Erreur -->
        @if (_erreur is not null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex-shrink:0">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>@_erreur</span>
            </div>
        }

        <!-- Formulaire -->
        <EditForm Model="_requete" OnValidSubmit="SoumettreAsync">
            <DataAnnotationsValidator />

            <div class="stack stack-md">

                <!-- Type -->
                <div>
                    <label class="form-label">Type de contenu</label>
                    <div class="type-toggle">
                        <div class="type-toggle-option">
                            <input type="radio" id="typeTexte" name="type"
                                   @onchange="() => _requete.TypeContenu = PartageTexte.Domain.Enumerations.TypeContenu.Texte"
                                   checked="@(_requete.TypeContenu == PartageTexte.Domain.Enumerations.TypeContenu.Texte)" />
                            <label for="typeTexte">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/>
                                </svg>
                                Texte
                            </label>
                        </div>
                        <div class="type-toggle-option">
                            <input type="radio" id="typeMotDePasse" name="type"
                                   @onchange="() => _requete.TypeContenu = PartageTexte.Domain.Enumerations.TypeContenu.MotDePasse" />
                            <label for="typeMotDePasse">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                                Mot de passe
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Contenu -->
                <div>
                    <label class="form-label" for="contenu">
                        @(_requete.TypeContenu == PartageTexte.Domain.Enumerations.TypeContenu.MotDePasse
                            ? "Mot de passe à partager"
                            : "Texte à partager")
                        <span style="color:var(--c-red)">*</span>
                    </label>
                    <textarea id="contenu" class="form-control font-mono"
                              rows="7"
                              placeholder="Collez ou saisissez le contenu ici..."
                              @bind="_requete.Contenu" />
                </div>

                <hr class="section-divider" />

                <div class="stack stack-sm">

                    <div>
                        <label class="form-label" for="expiration">
                            Expiration <span style="color:var(--c-red)">*</span>
                        </label>
                        <input id="expiration" type="datetime-local" class="form-control"
                               @bind="_dateExpirationLocale" required />
                        <div class="form-text">Par défaut : 1 semaine.</div>
                    </div>

                    <div>
                        <label class="form-label" for="motdepasse">Mot de passe de protection</label>
                        <input id="motdepasse" type="password" class="form-control"
                               placeholder="Optionnel — minimum 4 caractères"
                               @bind="_requete.MotDePasse" />
                    </div>

                    <div>
                        <label class="form-label" for="lectures">Nombre de lectures maximum</label>
                        <input id="lectures" type="number" class="form-control" min="1"
                               placeholder="Illimité si vide"
                               @bind="_requete.NombreLecturesMax" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_enCours">
                    @if (_enCours)
                    {
                        <span class="spinner-border"></span>
                        <span>Création en cours...</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        <span>Créer le partage sécurisé</span>
                    }
                </button>

            </div>
        </EditForm>

    </div>
</div>

@code {
    private readonly RequeteAvecDateLocale _requete = new();
    private DateTime? _dateExpirationLocale = DateTime.Now.AddDays(7);
    private bool _enCours;
    private bool _aideOuverte;
    private string? _erreur;

    private sealed class RequeteAvecDateLocale
    {
        public string Contenu { get; set; } = string.Empty;
        public PartageTexte.Domain.Enumerations.TypeContenu TypeContenu { get; set; }
            = PartageTexte.Domain.Enumerations.TypeContenu.Texte;
        public string? MotDePasse { get; set; }
        public int? NombreLecturesMax { get; set; }
    }

    private async Task SoumettreAsync()
    {
        _erreur = null;
        _enCours = true;

        try
        {
            var requeteApi = new PartageTexte.Application.DTOs.CreerPartageRequete
            {
                Contenu = _requete.Contenu,
                TypeContenu = _requete.TypeContenu,
                DateExpiration = _dateExpirationLocale.HasValue
                    ? DateTime.SpecifyKind(_dateExpirationLocale.Value, DateTimeKind.Local).ToUniversalTime()
                    : null,
                MotDePasse = string.IsNullOrEmpty(_requete.MotDePasse) ? null : _requete.MotDePasse,
                NombreLecturesMax = _requete.NombreLecturesMax
            };

            var reponse = await ClientPartage.CreerAsync(requeteApi);
            Navigation.NavigateTo($"/confirme/{reponse!.Id}");
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _enCours = false;
        }
    }
}
